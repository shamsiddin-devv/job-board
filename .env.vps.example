# Set this to a DNS hostname pointing at the VPS public IPv4.
API_DOMAIN=workuz-example.duckdns.org
# Until the browser frontend exists, use the API's own HTTPS origin.
FRONTEND_URL=https://workuz-example.duckdns.org

# Generate four different values with openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-64-hex-characters
ACCESS_TOKEN_SECRET=replace-with-a-unique-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-unique-random-refresh-secret
RESET_TOKEN_SECRET=replace-with-a-unique-random-reset-secret

# Configure these in the provider consoles for the final API hostname.
GOOGLE_CLIENT_ID=replace
GOOGLE_CLIENT_SECRET=replace
GOOGLE_CALLBACK_URL=https://workuz-example.duckdns.org/api/auth/google/callback
GITHUB_CLIENT_ID=replace
GITHUB_CLIENT_SECRET=replace
GITHUB_CALLBACK_URL=https://workuz-example.duckdns.org/api/auth/github/callback

SMTP_EMAIL=replace@example.com
SMTP_PASS=replace
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
CLOUDINARY_CLOUD_NAME=replace
CLOUDINARY_API_KEY=replace
CLOUDINARY_API_SECRET=replace
