NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://workuz:workuz_dev_only@localhost:5432/workuz
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=replace-with-a-unique-random-access-secret
REFRESH_TOKEN_SECRET=replace-with-a-unique-random-refresh-secret
RESET_TOKEN_SECRET=replace-with-a-unique-random-reset-secret
ACCESS_TOKEN_TIME=15m
REFRESH_TOKEN_TIME=30d
RESET_TOKEN_TIME=3m
SALT_ROUNDS=12
# Set SMTP_HOST and SMTP_PORT for a custom provider. Without a host, Gmail is used.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER is needed when the provider login differs from the sender address.
# SMTP_USER=provider-login
SMTP_EMAIL=replace@example.com
SMTP_PASS=replace
CLOUDINARY_CLOUD_NAME=replace
CLOUDINARY_API_KEY=replace
CLOUDINARY_API_SECRET=replace
GOOGLE_CLIENT_ID=replace
GOOGLE_CLIENT_SECRET=replace
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
GITHUB_CLIENT_ID=replace
GITHUB_CLIENT_SECRET=replace
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
